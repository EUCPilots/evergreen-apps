{
    "Name": "Mozilla Firefox",
    "Source": "https://www.mozilla.org/en-US/firefox/new/",
    "Get": {
        "Update": {
            "Uri": "https://product-details.mozilla.org/1.0/firefox_versions.json",
            "Channels": {
                "LATEST_FIREFOX_VERSION": "Current",
                "FIREFOX_ESR": "Extended Support",
                "FIREFOX_ESR_NEXT": "Extended Support Next",
                "FIREFOX_DEVEDITION": "Developer",
                "LATEST_FIREFOX_RELEASED_DEVEL_VERSION": "Beta"
            }
        },
        "Download": {
            "ReleaseUri": {
                "LATEST_FIREFOX_VERSION": "https://archive.mozilla.org/pub/firefox/releases/#version",
                "FIREFOX_ESR": "https://archive.mozilla.org/pub/firefox/releases/#version",
                "FIREFOX_ESR_NEXT": "https://archive.mozilla.org/pub/firefox/releases/#version",
                "FIREFOX_DEVEDITION": "https://archive.mozilla.org/pub/devedition/releases/#version",
                "LATEST_FIREFOX_RELEASED_DEVEL_VERSION": "https://archive.mozilla.org/pub/firefox/releases/#version"
            },
            "Msix": {
                "LATEST_FIREFOX_VERSION": "https://download.mozilla.org/?product=firefox-msix-latest-ssl&os=#platform&lang=en-US",
                "FIREFOX_ESR": "https://download.mozilla.org/?product=firefox-esr-msix-latest-ssl&os=#platform&lang=en-US",
                "FIREFOX_ESR_NEXT": "https://download.mozilla.org/?product=firefox-esr-next-msix-latest-ssl&os=#platform&lang=en-US",
                "FIREFOX_DEVEDITION": "https://download.mozilla.org/?product=firefox-devedition-msix-latest-ssl&os=#platform&lang=en-US",
                "LATEST_FIREFOX_RELEASED_DEVEL_VERSION": "https://download.mozilla.org/?product=firefox-beta-msix-latest-ssl&os=#platform&lang=en-US"
            },
            "Platforms": [
                "win64",
                "win",
                "win64-aarch64"
            ],
            "ReplaceText": {
                "Version": "esr"
            }
        }
    },
    "Install": {
        "Setup": "Firefox*.exe",
        "Physical": {
            "Arguments": "/S /TaskbarShortcut=false /DesktopShortcut=false /MaintenanceService=true /PreventRebootRequired=true",
            "PostInstall": []
        },
        "Virtual": {
            "Arguments": "/S /TaskbarShortcut=false /DesktopShortcut=false /MaintenanceService=false /PreventRebootRequired=true",
            "PostInstall": []
        }
    }
}
